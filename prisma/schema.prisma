generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  firstName          String               @db.VarChar(100)
  lastName           String               @db.VarChar(100)
  email              String               @unique @db.VarChar(320)
  passwordHash       String               @db.VarChar(255)
  active             Boolean              @default(true)
  lastLoginAt        DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?            @db.Timestamptz(3)
  roles              UserRole[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  assignedTickets    Ticket[]             @relation("TicketAssignee")
  ticketHistories    TicketHistory[]
  ticketMessages     TicketMessage[]
  ticketAttachments  TicketAttachment[]
  orderHistories     OrderStatusHistory[]

  @@index([active, deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  oldValues Json?
  newValues Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  value       Json
  category    String   @default("general") @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@map("settings")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum PriceMode {
  FIXED
  CONTACT
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  RESERVATION
  RELEASE
}

enum ServicePriceMode {
  FIXED
  FROM
  QUOTE
}

enum ServiceFormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
  DATE
  EMAIL
  PHONE
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_REVIEW
  WAITING_CUSTOMER
  QUOTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  WEB
  ADMIN
  WHATSAPP
  PHONE
  OTHER
}

enum TicketMessageType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum TicketHistoryAction {
  TICKET_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
}

enum DeliveryType {
  PICKUP
  DELIVERY
  DIGITAL
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  PAYMENT_PENDING
  PAID
  PREPARING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WEB
  ADMIN
  WHATSAPP
  PHONE
  OTHER
}

enum AvailabilitySource {
  OWN_STOCK
  SUPPLIER_STOCK
  DIGITAL
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  PRODUCTS_TOP
}

enum PromotionType {
  INFORMATIONAL
}

model CodeSequence {
  key       String   @id @db.VarChar(50)
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("code_sequences")
}

model Category {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(150)
  slug        String              @unique @db.VarChar(180)
  description String?             @db.Text
  imageUrl    String?             @db.VarChar(2048)
  icon        String?             @db.VarChar(100)
  parentId    String?             @db.Uuid
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]          @relation("CategoryTree")
  products    Product[]
  attributes  CategoryAttribute[]
  promotions  PromotionCategory[]

  @@index([parentId])
  @@index([active, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(180)
  description String?   @db.Text
  logoUrl     String?   @db.VarChar(2048)
  websiteUrl  String?   @db.VarChar(2048)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  products    Product[]

  @@index([active, deletedAt])
  @@map("brands")
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  supplierCode     String            @unique @db.VarChar(20)
  name             String            @db.VarChar(180)
  legalName        String?           @db.VarChar(220)
  taxId            String?           @db.VarChar(50)
  email            String?           @db.VarChar(320)
  phone            String?           @db.VarChar(50)
  whatsapp         String?           @db.VarChar(50)
  website          String?           @db.VarChar(2048)
  contactName      String?           @db.VarChar(180)
  notes            String?           @db.Text
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  supplierProducts SupplierProduct[]

  @@index([name])
  @@index([taxId])
  @@index([active, deletedAt])
  @@map("suppliers")
}

model Product {
  id                 String                  @id @default(uuid()) @db.Uuid
  productCode        String                  @unique @db.VarChar(20)
  sku                String                  @unique @db.VarChar(100)
  name               String                  @db.VarChar(220)
  slug               String                  @unique @db.VarChar(250)
  shortDescription   String?                 @db.VarChar(500)
  description        String?                 @db.Text
  productType        ProductType             @default(PHYSICAL)
  priceMode          PriceMode               @default(CONTACT)
  price              Decimal?                @db.Decimal(12, 2)
  priceIncludesTax   Boolean                 @default(false)
  taxRate            Decimal?                @db.Decimal(5, 2)
  brandId            String?                 @db.Uuid
  categoryId         String                  @db.Uuid
  manageStock        Boolean                 @default(true)
  active             Boolean                 @default(false)
  featured           Boolean                 @default(false)
  warranty           String?                 @db.VarChar(255)
  weight             Decimal?                @db.Decimal(12, 3)
  metaTitle          String?                 @db.VarChar(255)
  metaDescription    String?                 @db.VarChar(500)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?               @db.Timestamptz(3)
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  attributeValues    ProductAttributeValue[]
  variants           ProductVariant[]
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  supplierProducts   SupplierProduct[]
  orderItems         OrderItem[]
  promotions         PromotionProduct[]

  @@index([categoryId, active])
  @@index([brandId])
  @@index([priceMode])
  @@index([featured, active])
  @@index([deletedAt])
  @@map("products")
}

model Banner {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique @db.VarChar(20)
  title          String          @db.VarChar(180)
  subtitle       String?         @db.VarChar(220)
  description    String?         @db.VarChar(500)
  imageUrl       String          @db.VarChar(2048)
  mobileImageUrl String?         @db.VarChar(2048)
  ctaLabel       String?         @db.VarChar(80)
  ctaUrl         String?         @db.VarChar(2048)
  placement      BannerPlacement
  sortOrder      Int             @default(0)
  active         Boolean         @default(false)
  startsAt       DateTime?       @db.Timestamptz(3)
  endsAt         DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?       @db.Timestamptz(3)

  @@index([placement, active, sortOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("banners")
}

model Promotion {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(20)
  name        String              @db.VarChar(180)
  description String?             @db.VarChar(500)
  badge       String              @db.VarChar(40)
  type        PromotionType       @default(INFORMATIONAL)
  startsAt    DateTime?           @db.Timestamptz(3)
  endsAt      DateTime?           @db.Timestamptz(3)
  active      Boolean             @default(false)
  priority    Int                 @default(0)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)
  products    PromotionProduct[]
  categories  PromotionCategory[]

  @@index([active, priority])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String    @db.Uuid
  productId   String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String    @db.Uuid
  categoryId  String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  url        String   @db.VarChar(2048)
  storageKey String?  @db.VarChar(500)
  alt        String?  @db.VarChar(255)
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Attribute {
  id         String                  @id @default(uuid()) @db.Uuid
  name       String                  @db.VarChar(150)
  slug       String                  @unique @db.VarChar(180)
  type       AttributeType
  unit       String?                 @db.VarChar(50)
  filterable Boolean                 @default(false)
  variant    Boolean                 @default(false)
  active     Boolean                 @default(true)
  sortOrder  Int                     @default(0)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  options    AttributeOption[]
  categories CategoryAttribute[]
  values     ProductAttributeValue[]

  @@index([active, sortOrder])
  @@map("attributes")
}

model AttributeOption {
  id            String                        @id @default(uuid()) @db.Uuid
  attributeId   String                        @db.Uuid
  value         String                        @db.VarChar(150)
  label         String                        @db.VarChar(150)
  sortOrder     Int                           @default(0)
  active        Boolean                       @default(true)
  attribute     Attribute                     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productValues ProductAttributeValueOption[]
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@unique([attributeId, id])
  @@index([attributeId, active, sortOrder])
  @@map("attribute_options")
}

model CategoryAttribute {
  categoryId  String    @db.Uuid
  attributeId String    @db.Uuid
  required    Boolean   @default(false)
  sortOrder   Int       @default(0)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model ProductAttributeValue {
  id           String                        @id @default(uuid()) @db.Uuid
  productId    String                        @db.Uuid
  attributeId  String                        @db.Uuid
  textValue    String?                       @db.Text
  numberValue  Decimal?                      @db.Decimal(18, 4)
  booleanValue Boolean?
  product      Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute    Attribute                     @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  options      ProductAttributeValueOption[]

  @@unique([productId, attributeId])
  @@unique([id, attributeId])
  @@index([attributeId])
  @@map("product_attribute_values")
}

model ProductAttributeValueOption {
  productAttributeValueId String                @db.Uuid
  attributeId             String                @db.Uuid
  optionId                String                @db.Uuid
  productAttributeValue   ProductAttributeValue @relation(fields: [productAttributeValueId, attributeId], references: [id, attributeId], onDelete: Cascade)
  option                  AttributeOption       @relation(fields: [attributeId, optionId], references: [attributeId, id], onDelete: Restrict)

  @@id([productAttributeValueId, optionId])
  @@index([attributeId, optionId])
  @@index([optionId])
  @@map("product_attribute_value_options")
}

model ProductVariant {
  id                 String                  @id @default(uuid()) @db.Uuid
  productId          String                  @db.Uuid
  variantCode        String                  @unique @db.VarChar(20)
  sku                String                  @unique @db.VarChar(100)
  combinationKey     String                  @db.VarChar(1000)
  name               String?                 @db.VarChar(255)
  priceOverride      Decimal?                @db.Decimal(12, 2)
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?               @db.Timestamptz(3)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues    VariantAttributeValue[]
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  supplierProducts   SupplierProduct[]
  orderItems         OrderItem[]

  @@unique([productId, combinationKey])
  @@unique([productId, id])
  @@index([productId, active, deletedAt])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId   String          @db.Uuid
  attributeId String          @db.Uuid
  optionId    String          @db.Uuid
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option      AttributeOption @relation(fields: [attributeId, optionId], references: [attributeId, id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@unique([variantId, optionId])
  @@index([optionId])
  @@map("variant_attribute_values")
}

model InventoryLocation {
  id           String              @id @default(uuid()) @db.Uuid
  locationCode String              @unique @db.VarChar(20)
  name         String              @db.VarChar(150)
  description  String?             @db.VarChar(500)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?           @db.Timestamptz(3)
  stocks       InventoryStock[]
  movements    InventoryMovement[]

  @@index([active, deletedAt])
  @@map("inventory_locations")
}

model InventoryStock {
  id               String            @id @default(uuid()) @db.Uuid
  locationId       String            @db.Uuid
  productId        String            @db.Uuid
  variantId        String?           @db.Uuid
  quantityOnHand   Int               @default(0)
  quantityReserved Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant?   @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade)

  @@unique([locationId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_stocks")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  movementCode   String                @unique @db.VarChar(24)
  locationId     String                @db.Uuid
  productId      String                @db.Uuid
  variantId      String?               @db.Uuid
  type           InventoryMovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  referenceType  String?               @db.VarChar(100)
  referenceId    String?               @db.VarChar(100)
  reason         String                @db.VarChar(255)
  notes          String?               @db.Text
  createdById    String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  location       InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant?       @relation(fields: [productId, variantId], references: [productId, id], onDelete: Restrict)
  createdBy      User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([locationId, createdAt])
  @@index([productId, variantId, createdAt])
  @@index([createdById])
  @@map("inventory_movements")
}

model SupplierProduct {
  id            String          @id @default(uuid()) @db.Uuid
  supplierId    String          @db.Uuid
  productId     String          @db.Uuid
  variantId     String?         @db.Uuid
  supplierSku   String?         @db.VarChar(150)
  supplierCost  Decimal?        @db.Decimal(12, 2)
  supplierStock Int             @default(0)
  supplierUrl   String?         @db.VarChar(2048)
  leadTimeDays  Int?
  active        Boolean         @default(true)
  lastCheckedAt DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade)

  @@unique([supplierId, productId, variantId])
  @@index([productId, active])
  @@index([variantId])
  @@map("supplier_products")
}

model ServiceCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(150)
  slug        String            @unique @db.VarChar(180)
  description String?           @db.Text
  imageUrl    String?           @db.VarChar(2048)
  icon        String?           @db.VarChar(100)
  parentId    String?           @db.Uuid
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)
  parent      ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ServiceCategory[] @relation("ServiceCategoryTree")
  services    Service[]

  @@index([parentId])
  @@index([active, sortOrder])
  @@index([deletedAt])
  @@map("service_categories")
}

model Service {
  id                   String             @id @default(uuid()) @db.Uuid
  serviceCode          String             @unique @db.VarChar(20)
  name                 String             @db.VarChar(220)
  slug                 String             @unique @db.VarChar(250)
  shortDescription     String?            @db.VarChar(500)
  description          String?            @db.Text
  categoryId           String             @db.Uuid
  priceMode            ServicePriceMode   @default(QUOTE)
  price                Decimal?           @db.Decimal(12, 2)
  priceIncludesTax     Boolean            @default(false)
  taxRate              Decimal?           @db.Decimal(5, 2)
  estimatedDuration    String?            @db.VarChar(150)
  warranty             String?            @db.VarChar(255)
  remoteAvailable      Boolean            @default(false)
  onsiteAvailable      Boolean            @default(true)
  homeServiceAvailable Boolean            @default(false)
  requiresDevice       Boolean            @default(false)
  allowAttachments     Boolean            @default(false)
  imageUrl             String?            @db.VarChar(2048)
  featured             Boolean            @default(false)
  active               Boolean            @default(false)
  metaTitle            String?            @db.VarChar(255)
  metaDescription      String?            @db.VarChar(500)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?          @db.Timestamptz(3)
  category             ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fields               ServiceFormField[]
  tickets              Ticket[]

  @@index([categoryId, active])
  @@index([featured, active])
  @@index([priceMode])
  @@index([deletedAt])
  @@map("services")
}

model ServiceFormField {
  id               String                   @id @default(uuid()) @db.Uuid
  serviceId        String                   @db.Uuid
  key              String                   @db.VarChar(100)
  label            String                   @db.VarChar(180)
  description      String?                  @db.VarChar(500)
  placeholder      String?                  @db.VarChar(255)
  type             ServiceFormFieldType
  required         Boolean                  @default(false)
  active           Boolean                  @default(true)
  sortOrder        Int                      @default(0)
  validationConfig Json?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?                @db.Timestamptz(3)
  service          Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  options          ServiceFormFieldOption[]
  ticketValues     TicketFieldValue[]

  @@unique([serviceId, key])
  @@index([serviceId, active, sortOrder])
  @@map("service_form_fields")
}

model ServiceFormFieldOption {
  id           String                   @id @default(uuid()) @db.Uuid
  fieldId      String                   @db.Uuid
  value        String                   @db.VarChar(150)
  label        String                   @db.VarChar(180)
  sortOrder    Int                      @default(0)
  active       Boolean                  @default(true)
  field        ServiceFormField         @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  ticketValues TicketFieldValueOption[]

  @@unique([fieldId, value])
  @@index([fieldId, active, sortOrder])
  @@map("service_form_field_options")
}

model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  customerCode   String          @unique @db.VarChar(20)
  firstName      String          @db.VarChar(100)
  lastName       String          @db.VarChar(100)
  documentType   String?         @db.VarChar(30)
  documentNumber String?         @unique @db.VarChar(50)
  email          String?         @unique @db.VarChar(320)
  phone          String?         @db.VarChar(30)
  whatsapp       String?         @unique @db.VarChar(30)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?       @db.Timestamptz(3)
  tickets        Ticket[]
  messages       TicketMessage[]
  addresses      Address[]
  orders         Order[]

  @@index([firstName, lastName])
  @@index([active, deletedAt])
  @@map("customers")
}

model Ticket {
  id                       String             @id @default(uuid()) @db.Uuid
  ticketCode               String             @unique @db.VarChar(20)
  requestId                String?            @unique @db.VarChar(100)
  customerId               String             @db.Uuid
  serviceId                String             @db.Uuid
  subject                  String             @db.VarChar(255)
  description              String?            @db.Text
  status                   TicketStatus       @default(NEW)
  priority                 TicketPriority     @default(NORMAL)
  assignedUserId           String?            @db.Uuid
  source                   TicketSource       @default(WEB)
  whatsappHandoffTokenHash String?            @unique @db.Char(64)
  whatsappOpenedAt         DateTime?          @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)
  closedAt                 DateTime?          @db.Timestamptz(3)
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service                  Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedUser             User?              @relation("TicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  fieldValues              TicketFieldValue[]
  messages                 TicketMessage[]
  attachments              TicketAttachment[]
  history                  TicketHistory[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([serviceId, createdAt])
  @@index([customerId, createdAt])
  @@index([assignedUserId, status])
  @@index([createdAt])
  @@map("tickets")
}

model TicketFieldValue {
  id           String                   @id @default(uuid()) @db.Uuid
  ticketId     String                   @db.Uuid
  fieldId      String?                  @db.Uuid
  fieldKey     String                   @db.VarChar(100)
  fieldLabel   String                   @db.VarChar(180)
  fieldType    ServiceFormFieldType
  textValue    String?                  @db.Text
  numberValue  Decimal?                 @db.Decimal(18, 4)
  booleanValue Boolean?
  dateValue    DateTime?                @db.Date
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  ticket       Ticket                   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field        ServiceFormField?        @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  options      TicketFieldValueOption[]

  @@unique([ticketId, fieldKey])
  @@index([fieldId])
  @@map("ticket_field_values")
}

model TicketFieldValueOption {
  id                 String                  @id @default(uuid()) @db.Uuid
  ticketFieldValueId String                  @db.Uuid
  optionId           String?                 @db.Uuid
  optionValue        String                  @db.VarChar(150)
  optionLabel        String                  @db.VarChar(180)
  ticketFieldValue   TicketFieldValue        @relation(fields: [ticketFieldValueId], references: [id], onDelete: Cascade)
  option             ServiceFormFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([ticketFieldValueId, optionValue])
  @@index([optionId])
  @@map("ticket_field_value_options")
}

model TicketMessage {
  id           String             @id @default(uuid()) @db.Uuid
  ticketId     String             @db.Uuid
  authorUserId String?            @db.Uuid
  customerId   String?            @db.Uuid
  type         TicketMessageType
  message      String             @db.Text
  internal     Boolean            @default(false)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser   User?              @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attachments  TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id               String         @id @default(uuid()) @db.Uuid
  ticketId         String         @db.Uuid
  messageId        String?        @db.Uuid
  fileName         String         @db.VarChar(255)
  mimeType         String         @db.VarChar(150)
  size             Int
  url              String         @db.VarChar(2048)
  storageKey       String         @db.VarChar(500)
  uploadedByUserId String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message          TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedByUser   User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([messageId])
  @@map("ticket_attachments")
}

model TicketHistory {
  id                 String              @id @default(uuid()) @db.Uuid
  ticketId           String              @db.Uuid
  userId             String?             @db.Uuid
  action             TicketHistoryAction
  fromStatus         TicketStatus?
  toStatus           TicketStatus?
  fromPriority       TicketPriority?
  toPriority         TicketPriority?
  fromAssignedUserId String?             @db.Uuid
  toAssignedUserId   String?             @db.Uuid
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  ticket             Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId])
  @@map("ticket_history")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @db.Uuid
  label         String    @default("Principal") @db.VarChar(80)
  recipientName String    @db.VarChar(220)
  country       String    @db.VarChar(2)
  province      String    @db.VarChar(120)
  city          String    @db.VarChar(120)
  addressLine1  String    @db.VarChar(255)
  addressLine2  String?   @db.VarChar(255)
  reference     String    @db.VarChar(500)
  postalCode    String?   @db.VarChar(30)
  phone         String?   @db.VarChar(30)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders        Order[]   @relation("OrderCustomerAddress")

  @@unique([customerId, id])
  @@index([customerId, deletedAt])
  @@map("addresses")
}

model Order {
  id                       String               @id @default(uuid()) @db.Uuid
  orderNumber              String               @unique @db.VarChar(20)
  requestId                String               @unique @db.Uuid
  checkoutFingerprint      String               @db.Char(43)
  customerId               String               @db.Uuid
  addressId                String?              @db.Uuid
  status                   OrderStatus          @default(NEW)
  deliveryType             DeliveryType
  subtotal                 Decimal              @db.Decimal(14, 2)
  discount                 Decimal              @default(0) @db.Decimal(14, 2)
  tax                      Decimal              @db.Decimal(14, 2)
  shipping                 Decimal              @default(0) @db.Decimal(14, 2)
  total                    Decimal              @db.Decimal(14, 2)
  currency                 String               @db.VarChar(3)
  shippingPendingQuote     Boolean              @default(false)
  notes                    String?              @db.Text
  source                   OrderSource          @default(WEB)
  whatsappHandoffTokenHash String?              @unique @db.Char(64)
  whatsappOpenedAt         DateTime?            @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  confirmedAt              DateTime?            @db.Timestamptz(3)
  paidAt                   DateTime?            @db.Timestamptz(3)
  cancelledAt              DateTime?            @db.Timestamptz(3)
  completedAt              DateTime?            @db.Timestamptz(3)
  customer                 Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address                  Address?             @relation("OrderCustomerAddress", fields: [customerId, addressId], references: [customerId, id], onDelete: Restrict)
  deliveryAddress          OrderAddress?
  items                    OrderItem[]
  history                  OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([customerId, addressId])
  @@index([createdAt])
  @@index([whatsappOpenedAt])
  @@index([deliveryType, createdAt])
  @@map("orders")
}

model OrderAddress {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  recipientName String   @db.VarChar(220)
  country       String   @db.VarChar(2)
  province      String   @db.VarChar(120)
  city          String   @db.VarChar(120)
  addressLine1  String   @db.VarChar(255)
  addressLine2  String?  @db.VarChar(255)
  reference     String   @db.VarChar(500)
  postalCode    String?  @db.VarChar(30)
  phone         String?  @db.VarChar(30)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id                    String             @id @default(uuid()) @db.Uuid
  orderId               String             @db.Uuid
  productId             String?            @db.Uuid
  variantId             String?            @db.Uuid
  productCodeSnapshot   String             @db.VarChar(20)
  skuSnapshot           String             @db.VarChar(100)
  productNameSnapshot   String             @db.VarChar(220)
  variantSnapshot       String?            @db.VarChar(255)
  unitPrice             Decimal            @db.Decimal(14, 2)
  taxRate               Decimal            @db.Decimal(5, 2)
  taxAmount             Decimal            @db.Decimal(14, 2)
  quantity              Int
  subtotal              Decimal            @db.Decimal(14, 2)
  total                 Decimal            @db.Decimal(14, 2)
  priceIncludesTax      Boolean
  availabilitySource    AvailabilitySource
  productTypeSnapshot   ProductType        @default(PHYSICAL)
  estimatedLeadTimeDays Int?
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant               ProductVariant?    @relation(fields: [productId, variantId], references: [productId, id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([availabilitySource])
  @@index([productTypeSnapshot])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String?      @db.Uuid
  notes      String?      @db.Text
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([userId])
  @@map("order_status_history")
}
