{
  "name": "ajksolutions-ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:migration:phase6-2": "node scripts/verify-phase6-2-migration.mjs",
    "test:database:phase7": "node scripts/verify-phase7-empty-database.mjs",
    "test:database:phase8-5": "node scripts/verify-phase8-5-empty-database.mjs",
    "test:integrity:phase7": "node scripts/verify-phase7-content-integrity.mjs",
    "test:precheck:phase7": "node scripts/check-phase7-current-content.mjs",
    "test:e2e": "playwright test --grep-invert ^visual",
    "test:ui:phase7-5": "vitest run tests/unit/ui-phase7-5.test.ts && playwright test tests/e2e/ui-phase7-5.spec.ts",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update-snapshots",
    "test:production-config": "vitest run tests/unit/production-readiness.test.ts",
    "test:health": "playwright test tests/e2e/production-readiness.spec.ts",
    "test:security": "vitest run tests/unit/admin-session-security.test.ts tests/unit/production-readiness.test.ts",
    "test:seo": "playwright test tests/e2e/production-readiness.spec.ts",
    "smoke:production": "node scripts/production-smoke.mjs",
    "performance:baseline": "node scripts/performance-baseline.mjs",
    "release:check": "pnpm exec prisma format --check && pnpm exec prisma validate && pnpm db:generate && pnpm exec prisma migrate status && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm test:visual && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.0",
    "@pinia/nuxt": "1.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "pg": "8.23.0",
    "pinia": "3.0.3",
    "vue": "3.5.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@playwright/test": "1.62.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "eslint": "10.9.0",
    "happy-dom": "20.11.13",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
