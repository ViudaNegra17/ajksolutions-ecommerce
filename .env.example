NODE_ENV=development
# CRITICAL / PRIVATE: database credentials and independent signing material.
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5432/ajksolutions_ecommerce?schema=public
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_CHECKOUT_SIGNING_SECRET=replace-with-a-different-32-character-random-secret
NUXT_ORDER_HANDOFF_SECRET=replace-with-another-32-character-random-secret
# CRITICAL / PUBLIC: canonical HTTPS origin in production; never localhost.
NUXT_PUBLIC_APP_URL=http://localhost:3000
# PRIVATE / SEED ONLY: never configure seed credentials in the runtime service.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
SEED_DEFAULT_TAX_RATE=15.00
SEED_BUSINESS_WHATSAPP=0999999999
# OPTIONAL / PUBLIC: business contact destination.
WHATSAPP_NUMBER=
# OPTIONAL / PRIVATE: object-storage credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# OPTIONAL / PUBLIC: public object-storage asset origin.
R2_PUBLIC_URL=
# OPTIONAL / PRIVATE: external observability endpoint.
SENTRY_DSN=
